# CloudVault Environment Configuration

# Flask Core Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=generate_a_random_secret_key_here_for_production

# Database Configuration
DATABASE_URL=sqlite:///cloudvault.db

# Storage Configuration
# Options: local (current default), azure (future cloud deployment)
STORAGE_TYPE=local
UPLOAD_FOLDER=storage/uploads
MAX_CONTENT_LENGTH=52428800  # 50 MB limit in bytes

# Microsoft Azure Blob Storage (Future Integration Settings)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# AZURE_CONTAINER_NAME=cloudvault-files
